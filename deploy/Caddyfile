# Basic-auth front door for MoneyPrinterTurbo. MPT ships no WebUI auth, and
# its WebUI displays the configured API keys, so nothing reaches it without
# a password. Credentials come from .env (BASIC_AUTH_USER / BASIC_AUTH_HASH).
# An empty BASIC_AUTH_HASH makes Caddy refuse to start - that is intentional.
{
	admin off
	auto_https off
}

(auth) {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
}

# REST API (docs at /docs)
:8080 {
	import auth
	reverse_proxy api:8080
}

# Streamlit WebUI (websockets are proxied transparently)
:8501 {
	import auth
	reverse_proxy webui:8501
}
