# --- Vendored upstream (rebuilt via `make vendor`) ---
vendor/

# --- Secrets / credentials ---
.env
.env.*
!.env.example
.credentials/
*.token.json
client_secret*.json

# --- Rendered config (template is config/config.template.toml) ---
config/config.toml

# --- Generated media, sidecars, quota ledger ---
output/
!output/queue_state.json
!output/.gitkeep

# Series scripts live under topics/series/ (tracked for GitHub Actions).
# Keep rejected drafts local-only if present under output.


# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
