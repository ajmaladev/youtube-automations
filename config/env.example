# Template for .env (`make setup` copies it). .env is gitignored and is the ONLY
# place real secrets may live. Everything runs in --dry-run with this file empty.

# ---------------------------------------------------------------- video generation
# REQUIRED for real generation. Free: https://www.pexels.com/api/ (sign in -> "Your API key")
PEXELS_API_KEY=

# LLM used by MoneyPrinterTurbo to write scripts: "ollama" (free, local) or "openai".
LLM_PROVIDER=ollama
# REQUIRED if LLM_PROVIDER=ollama. Install https://ollama.com, run `ollama pull llama3.1`.
# From inside Docker the host is host.docker.internal. "/v1" is appended automatically.
OLLAMA_HOST=http://host.docker.internal:11434
# OPTIONAL. Any model shown by `ollama list`.
OLLAMA_MODEL=llama3.1
# REQUIRED only if LLM_PROVIDER=openai. Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL. Premium TTS instead of free Edge TTS: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------- MoneyPrinterTurbo access
# OPTIONAL. Where the orchestrator reaches MPT (through Caddy). Default shown.
MPT_BASE_URL=http://127.0.0.1:8080
# OPTIONAL but recommended. Any long random string; MPT then requires the x-api-key header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MPT_API_KEY=

# REQUIRED for `make up`. Caddy basic auth in front of MPT API + WebUI.
BASIC_AUTH_USER=admin
# REQUIRED for `make up`. bcrypt hash of your password: `make caddy-hash`.
# Wrap in SINGLE quotes - the hash contains "$" which Docker Compose would otherwise interpolate.
BASIC_AUTH_HASH=''
# REQUIRED for real generate/upload runs. Plain-text password matching the hash (used by the orchestrator).
BASIC_AUTH_PASSWORD=
# OPTIONAL. Interface Caddy binds to. Keep 127.0.0.1 unless you add TLS.
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------- YouTube upload
# REQUIRED for real uploads. Path to the OAuth "Desktop app" client JSON downloaded from
# Google Cloud Console -> APIs & Services -> Credentials. Keep it in .credentials/.
YOUTUBE_CLIENT_SECRETS_PATH=.credentials/client_secret.json
# OPTIONAL. Quota accounting (resets midnight Pacific). Uploads are hard-capped at 5/day.
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_UPLOAD_UNIT_COST=1600
YOUTUBE_MAX_UPLOADS_PER_DAY=5

# ---------------------------------------------------------------- scheduling
# OPTIONAL. Topics generated per `make daily` run.
DAILY_GENERATE_COUNT=1
# OPTIONAL. MPT polling.
MPT_POLL_INTERVAL_S=10
MPT_GENERATE_TIMEOUT_S=1800
