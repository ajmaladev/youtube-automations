# Template for .env (`make setup` copies it). .env is gitignored and is the ONLY
# place real secrets may live. Everything runs in --dry-run with this file empty.

# ---------------------------------------------------------------- video generation
# REQUIRED for real generation. Free: https://www.pexels.com/api/ (sign in -> "Your API key")
PEXELS_API_KEY=

# LLM used by the video engine to write scripts: "ollama" (free, local) or "openai".
LLM_PROVIDER=ollama
# REQUIRED if LLM_PROVIDER=ollama. Install https://ollama.com, run `ollama pull llama3.1`.
# From inside Docker the host is host.docker.internal. "/v1" is appended automatically.
OLLAMA_HOST=http://host.docker.internal:11434
# OPTIONAL. Any model shown by `ollama list`.
OLLAMA_MODEL=llama3.1
# REQUIRED only if LLM_PROVIDER=openai. Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL. Premium TTS instead of free Edge TTS: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------- content calendar
# OPTIONAL. Folder of pre-written months (topics/calendar/YYYY-MM.json). Days it covers are rendered from the
# file and never invented by AUTO_SERIES. Check the files with `make calendar`. Default: topics/calendar
CONTENT_CALENDAR_DIR=
# OPTIONAL. Render episodes this many days ahead, so you can approve them before their day.
CALENDAR_LOOKAHEAD_DAYS=1

# ---------------------------------------------------------------- automatic story series
# OPTIONAL. true = when topics/queue.yaml has nothing left, the AI plans a new multi-part series
# (settings: topics/channel.yaml; every past series is kept in topics/history.json and never repeated).
AUTO_SERIES=true
# OPTIONAL. LLM that writes the series: ollama (free, local) | groq | gemini | openai.
STORY_LLM_PROVIDER=ollama
# OPTIONAL. Model override. Defaults: ollama llama3.1, groq openai/gpt-oss-20b, gemini gemini-3.1-pro-preview.
STORY_LLM_MODEL=
# OPTIONAL (groq only). Model that researches sourced facts with Groq's browser_search tool (~30k tokens per
# series; free tier allows 200k tokens/day per model). Scripts are then fact-checked against those facts.
# "off" disables web research (not recommended for a facts channel).
STORY_RESEARCH_MODEL=openai/gpt-oss-120b
# OPTIONAL. Planning refuses to run without web research (non-groq providers invent "facts").
# true = allow unverified series anyway. Testing only - never publish those videos.
STORY_ALLOW_UNVERIFIED=false
# REQUIRED only if STORY_LLM_PROVIDER=groq. Free tier: https://console.groq.com/keys
GROQ_API_KEY=
# REQUIRED only if STORY_LLM_PROVIDER=gemini. Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------- video engine access
# OPTIONAL. Where the orchestrator reaches the engine (through Caddy). Default shown.
ENGINE_BASE_URL=http://127.0.0.1:8080
# OPTIONAL but recommended. Any long random string; the engine then requires the x-api-key header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_KEY=

# REQUIRED for `make up`. Caddy basic auth in front of the engine API + WebUI.
BASIC_AUTH_USER=admin
# REQUIRED for `make up`. bcrypt hash of your password: `make caddy-hash`.
# Wrap in SINGLE quotes - the hash contains "$" which Docker Compose would otherwise interpolate.
BASIC_AUTH_HASH=''
# REQUIRED for real generate/upload runs. Plain-text password matching the hash (used by the orchestrator).
BASIC_AUTH_PASSWORD=
# OPTIONAL. Interface Caddy binds to. Keep 127.0.0.1 unless you add TLS.
BIND_ADDR=127.0.0.1
# OPTIONAL. Host ports for the API / WebUI. If you change ENGINE_HOST_PORT, update ENGINE_BASE_URL to match.
ENGINE_HOST_PORT=8080
WEBUI_HOST_PORT=8501

# ---------------------------------------------------------------- YouTube upload
# REQUIRED for real uploads. Path to the OAuth "Desktop app" client JSON downloaded from
# Google Cloud Console -> APIs & Services -> Credentials. Keep it in .credentials/.
YOUTUBE_CLIENT_SECRETS_PATH=.credentials/client_secret.json
# OPTIONAL. Quota accounting (resets midnight Pacific). Uploads are hard-capped at 5/day.
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_UPLOAD_UNIT_COST=1600
YOUTUBE_MAX_UPLOADS_PER_DAY=5
# OPTIONAL. true = approved calendar episodes upload private with a scheduled publish time (their slot in the
# calendar file) and YouTube makes them public then. false = they stay private until you publish them.
YOUTUBE_SCHEDULE_PUBLISH=false

# ---------------------------------------------------------------- scheduling
# OPTIONAL. Videos generated per `make daily` run. 3 = one full calendar day (p1, p2, p3).
DAILY_GENERATE_COUNT=3
# OPTIONAL. Engine polling.
ENGINE_POLL_INTERVAL_S=10
ENGINE_GENERATE_TIMEOUT_S=1800
# OPTIONAL. A failed or broken render is tried this many times in total (the last attempt widens the
# stock-footage search), waiting GENERATE_RETRY_DELAY_S seconds in between.
GENERATE_ATTEMPTS=3
GENERATE_RETRY_DELAY_S=30
# OPTIONAL. Check every rendered MP4 (complete file, 1080x1920 frame, narration audio, sensible length).
VERIFY_VIDEOS=true
